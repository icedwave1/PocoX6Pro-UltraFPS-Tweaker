#!/sbin/sh
#################
# Universal KernelSU / Magisk / APatch Module Installer
#################
umask 022

ui_print() { echo "$1"; }

require_root() {
  ui_print "****************************************"
  ui_print " Please flash via KernelSU, APatch or Magisk! "
  ui_print "****************************************"
  exit 1
}

OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null

if [ -f /data/adb/ksu/util_functions.sh ]; then
  . /data/adb/ksu/util_functions.sh
  install_module
  exit 0
elif [ -f /data/adb/ap/util_functions.sh ]; then
  . /data/adb/ap/util_functions.sh
  install_module
  exit 0
elif [ -f /data/adb/magisk/util_functions.sh ]; then
  . /data/adb/magisk/util_functions.sh
  install_module
  exit 0
else
  require_root
fi
